<%- include('partials/header') %>

<div class="dashboard">
  <h2>Dashboard</h2>

  <div class="stats-grid">
    <div class="stat-card total">
      <h3>Total Tasks</h3>
      <p class="number"><%= total %></p>
    </div>
    <div class="stat-card completed">
      <h3>Completed</h3>
      <p class="number"><%= completed %></p>
    </div>
    <div class="stat-card pending">
      <h3>Pending</h3>
      <p class="number"><%= total - completed %></p>
    </div>
  </div>

  <div class="actions">
    <a href="/tasks/add" class="btn large primary">+ Add New Task</a>
      <a href="/tasks" class="btn large primary">View All Tasks</a>
  </div>
</div>

<%- include('partials/footer') %>