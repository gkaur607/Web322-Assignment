<%- include('../partials/header') %>

<h2>My Tasks</h2>

<a href="/tasks/add">+ Add New Task</a> | 
<a href="/dashboard">Back to Dashboard</a>

<table class="task-table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Due Date</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% if (tasks.length === 0) { %>
      <tr>
        <td colspan="4">No tasks found</td>
      </tr>
    <% } else { %>
      <% tasks.forEach(task => { %>
        <tr>
          <td><%= task.title %></td>

          <td>
            <%= task.dueDate ? task.dueDate.toISOString().split('T')[0] : '' %>
          </td>

          <td><%= task.status %></td>

          <td>
            <!-- Edit Button -->
            <a class="btn-edit" href="/tasks/edit/<%= task.id %>">Edit</a>

            <!-- Delete Button -->
            <form action="/tasks/delete/<%= task.id %>" 
                  method="POST" 
                  style="display:inline;">
              <button class="btn-delete" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>

<%- include('../partials/footer') %>